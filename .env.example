# =============================================================================
# LOCAL DEVELOPMENT: copy to .env.local and fill in values (never commit .env.local)
# =============================================================================

# --- Required for AI (chat + voice) — server reads this; not bundled in the browser ---
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional overrides (defaults: gemini-2.0-flash chat, gemini-2.5-flash-tts speech)
# GEMINI_CHAT_MODEL="gemini-2.0-flash"
# GEMINI_SPEECH_MODEL="gemini-2.5-flash-tts"

# --- Optional ---
APP_URL="https://your-vercel-domain.vercel.app"

# Firebase Admin (server-side Firestore + cron). Paste ONE LINE JSON from Firebase service account.
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Optional: protect GET /api/cron/reminders — Authorization: Bearer <value>
# CRON_SECRET=

# =============================================================================
# VERCEL DASHBOARD (you must add these manually — we cannot push secrets from git)
# Project → Settings → Environment Variables → "Add Environment Variable"
#
# Minimum for the app to answer in chat after deploy:
#   Name:  GEMINI_API_KEY
#   Value: (paste the same key from Google AI Studio)
#   Environments: check Production (and Preview if you test preview URLs)
#
# For credits / Paystack verify / server Firestore writes:
#   Name:  FIREBASE_SERVICE_ACCOUNT_JSON
#   Value: (paste entire service account JSON as ONE line)
#   Environments: Production (+ Preview as needed)
#
# After saving variables: Deployments → … → Redeploy (or push a commit).
# =============================================================================

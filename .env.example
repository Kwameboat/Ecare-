# GEMINI_API_KEY: Used only on the server (Express / Vercel serverless). Never exposed in the browser bundle.
# Get a key at https://aistudio.google.com/apikey — add the same variable in Vercel → Environment Variables for production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Vercel / production (Firebase Admin) ---
# JSON string of your Firebase service account (Project settings > Service accounts).
# Required on Vercel so Firestore Admin (API routes, cron) can authenticate.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Optional: if set, /api/cron/reminders requires Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
